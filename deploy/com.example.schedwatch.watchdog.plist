<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.schedwatch.watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/env</string><string>python3</string><string>-m</string><string>schedwatch</string>
    <string>watchdog</string>
    <string>--config</string><string>/path/to/config/jobs.json</string>
    <string>--db</string><string>/path/to/data/runs.db</string>
  </array>
  <key>StartInterval</key><integer>300</integer>
  <key>WorkingDirectory</key><string>/path/to/scheduler-watchdog</string>
  <key>EnvironmentVariables</key><dict><key>PYTHONPATH</key><string>/path/to/scheduler-watchdog/src</string></dict>
  <key>StandardOutPath</key><string>/path/to/data/watchdog.out.log</string>
  <key>StandardErrorPath</key><string>/path/to/data/watchdog.err.log</string>
</dict>
</plist>
